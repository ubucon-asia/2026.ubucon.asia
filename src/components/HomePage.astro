---
import Navigation from "./Navigation.astro";
import MainBanner from "./MainBanner.astro";
import { getLocalizedPath, useTranslations } from "../i18n/ui";
import BoothImage from "../assets/booth.jpg";
import HeroImage from "../assets/uca25photo.png";
import PrimesessionImage from "../assets/primesession.jpg";
import SpeakerImage from "../assets/speaker.jpg";
import Sponsors from "./Sponsors.astro";
import { WebsiteConfig } from '../config/site';
import FeaturedSpeakers from '../components/FeaturedSpeakers.astro';
import OtherSpeakers from '../components/OtherSpeakers.astro';
const { locale } = Astro.props;
const t = useTranslations(locale) as (key: string) => string;
---

<main>
    <Navigation locale={locale} />
    <MainBanner locale={locale} />
    <div class="p-section p-strip--dark" id="3-columns-responsive">
        <div class="u-fixed-width">
            <div class="p-section--shallow">
                <div class="p-image-container--cinematic is-cover">
                    <img
                        class="p-image-container__image"
                        src={HeroImage.src}
                        alt="Ubucon Asia 2025"
                    />
                </div>
            </div>
            <!-- <hr class="p-rule is-fixed-width" /> -->
              	{WebsiteConfig.featuredSpeakers.displayOnMainPage ? (<FeaturedSpeakers/>):(<></>)}
                <div id="other-speakers-container" class="speakers-accordion" style="display: none;">
                    {WebsiteConfig.otherSpeakers.displayOnMainPage ? (<OtherSpeakers/>):(<></>)}
                </div>
            <div class="p-section--shallow">
                <div class="grid-row--50-50-on-large">
                    <div class="grid-col">
                        <h2>{t("contributeTitle")}</h2>
                    </div>
                    <div class="grid-col">
                        <p class="p-heading--5">
                            {t("contributeDescription")}
                        </p>
                    </div>
                </div>
            </div>
        <div class="grid-row">
            <div class="grid-col-6 grid-col-start-large-3">
                <div class="p-equal-height-row--wrap">
                    <div class="p-equal-height-row__col is-borderless">
                        <div class="p-equal-height-row__item">
                            <div
                                class="p-image-container p-image-container--square-on-small p-image-container--square-on-medium p-image-container--2-3-on-large is-cover"
                            >
                                <img
                                    src={SpeakerImage.src}
                                    class="p-image-container__image"
                                    width="284"
                                    height="426"
                                    alt="Kernelt"
                                />
                            </div>
                            <hr class="p-rule--highlight" />
                        </div>
                        <div class="p-equal-height-row__item">
                            <p class="p-heading--5">
                                {t("contributeSpeakerTitle")}
                            </p>
                        </div>
                        <div class="p-equal-height-row__item">
                            <p>{t("contributeSpeakerDescription")}</p>
                        </div>
                        <div class="p-equal-height-row__item">
                            <p>
                                <a href="/cfp"
                                    >{t("contributeSpeakerLinkLabel")}&nbsp;›</a
                                >
                            </p>
                        </div>
                    </div>
                    <div class="p-equal-height-row__col is-borderless">
                        <div class="p-equal-height-row__item">
                            <div
                                class="p-image-container p-image-container--square-on-small p-image-container--square-on-medium p-image-container--2-3-on-large is-cover"
                            >
                                <img
                                    src={PrimesessionImage.src}
                                    class="p-image-container__image"
                                    width="284"
                                    height="426"
                                    alt="Kernelt"
                                />
                            </div>
                            <hr class="p-rule--highlight" />
                        </div>
                        <div class="p-equal-height-row__item">
                            <p class="p-heading--5">
                                {t("contributePrimeTitle")}
                            </p>
                        </div>
                        <div class="p-equal-height-row__item">
                            <p>{t("contributePrimeDescription")}</p>
                        </div>
                        <div class="p-equal-height-row__item">
                            <p>
                                <a
                                    href="https://discourse.ubuntu.com/t/call-for-nominations-ubucon-asia-2026-coscup-prime-session-speaker/78309"
                                    >{t("contributePrimeLinkLabel")}&nbsp;›</a
                                >
                            </p>
                        </div>
                    </div>
                    <div class="p-equal-height-row__col is-borderless">
                        <div class="p-equal-height-row__item">
                            <div
                                class="p-image-container p-image-container--square-on-small p-image-container--square-on-medium p-image-container--2-3-on-large is-cover"
                            >
                                <img
                                    src={BoothImage.src}
                                    class="p-image-container__image"
                                    width="284"
                                    height="426"
                                    alt="Kernelt"
                                />
                            </div>
                            <hr class="p-rule--highlight" />
                        </div>
                        <div class="p-equal-height-row__item">
                            <p class="p-heading--5">
                                {t("contributeBoothTitle")}
                            </p>
                        </div>
                        <div class="p-equal-height-row__item">
                            <p>{t("contributeBoothDescription")}</p>
                        </div>
                        <div class="p-equal-height-row__item">
                            <p>
                                <a
                                    href="https://discourse.ubuntu.com/t/call-for-booth-volunteers-ubucon-asia-2026-coscup/78729"
                                    >{t("contributeBoothLinkLabel")}&nbsp;›</a
                                >
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <Sponsors locale={locale} />
    <style>
        .speakers-accordion {
            transition: opacity 0.3s ease-in-out;
        }
    </style>
    <script>
    // Accordion functionality for speakers section
    document.addEventListener('DOMContentLoaded', function() {
        const seeAllSpeakersBtn = document.getElementById('see-all-speakers-btn');
        const otherSpeakersContainer = document.getElementById('other-speakers-container');
        
        if (seeAllSpeakersBtn && otherSpeakersContainer) {
        seeAllSpeakersBtn.addEventListener('click', function(e) {
            e.preventDefault();
            
            if (otherSpeakersContainer.style.display === 'none') {
            otherSpeakersContainer.style.display = 'block';
            otherSpeakersContainer.style.opacity = '0';
            
            setTimeout(() => {
                otherSpeakersContainer.style.transition = 'opacity 0.3s ease-in-out';
                otherSpeakersContainer.style.opacity = '1';
            }, 10);
            
            otherSpeakersContainer.scrollIntoView({ 
                behavior: 'smooth', 
                block: 'start' 
            });
            } else {
            otherSpeakersContainer.style.transition = 'opacity 0.3s ease-in-out';
            otherSpeakersContainer.style.opacity = '0';
            
            setTimeout(() => {
                otherSpeakersContainer.style.display = 'none';
            }, 300);
            }
        });
        }
    });
    </script>
</main>
